rules_version = '2';

// Deny by default: anything not listed below is refused.
// Publish these in the Firebase console: Build > Firestore Database > Rules (see docs/FIREBASE_LOGIN_SETUP.md).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function text(v, max) { return v is string && v.size() <= max; }

    // A learner's profile: only they can read or change it.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'goal', 'createdAt'])
        && text(request.resource.data.get('name', ''), 80)
        && text(request.resource.data.get('goal', ''), 40);
    }

    // A learner's saved lesson progress: only they can read or change it.
    match /progress/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['done', 'phases', 'last', 'updatedAt'])
        && request.resource.data.done is map
        && request.resource.data.phases is map
        && request.resource.data.size() <= 4
        && request.resource.data.done.size() <= 20
        && request.resource.data.phases.size() <= 600;
    }

    // Website enquiries: anyone may send one, nobody can read, change or delete them from the website.
    // Read them in the Firebase console (Firestore Database > Data).
    match /enquiries/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'who', 'service', 'message', 'createdAt'])
        && text(request.resource.data.get('name', ''), 120) && request.resource.data.name.size() > 0
        && text(request.resource.data.get('email', ''), 160) && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && text(request.resource.data.get('phone', ''), 30)
        && text(request.resource.data.get('who', ''), 60)
        && text(request.resource.data.get('service', ''), 80)
        && text(request.resource.data.get('message', ''), 2000) && request.resource.data.message.size() > 0;
      allow read, update, delete: if false;
    }

    // Careers applications: same idea.
    match /applications/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'role', 'cv', 'linkedin', 'message', 'createdAt'])
        && text(request.resource.data.get('name', ''), 120) && request.resource.data.name.size() > 0
        && text(request.resource.data.get('email', ''), 160) && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && text(request.resource.data.get('phone', ''), 30)
        && text(request.resource.data.get('role', ''), 60)
        && text(request.resource.data.get('cv', ''), 300)
        && text(request.resource.data.get('linkedin', ''), 300)
        && text(request.resource.data.get('message', ''), 3000) && request.resource.data.message.size() > 0;
      allow read, update, delete: if false;
    }

    // ---- Blog admin ---------------------------------------------------------------------------------
    // An administrator is a signed-in person who has a document in the 'admins' collection whose ID is their
    // account ID. Only you can create that document, in the Firebase console (docs/FIREBASE_LOGIN_SETUP.md).
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    match /admins/{uid} {
      allow get: if isOwner(uid);      // lets the website ask "am I an administrator?"
      allow list, write: if false;
    }

    // Blog posts written in the admin area. Visitors can read published posts only; drafts are visible to admins.
    match /posts/{slug} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && slug.matches('[a-z0-9]+(-[a-z0-9]+)*') && slug.size() >= 3 && slug.size() <= 80
        && request.resource.data.keys().hasOnly(['title', 'summary', 'body', 'date', 'published', 'coverPhoto', 'coverImage', 'coverAlt', 'thumb', 'author', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['title', 'summary', 'body', 'date', 'published'])
        && text(request.resource.data.title, 140) && request.resource.data.title.size() > 0
        && text(request.resource.data.summary, 300)
        && text(request.resource.data.body, 40000) && request.resource.data.body.size() > 0
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.published is bool
        && text(request.resource.data.get('coverPhoto', ''), 60)
        && text(request.resource.data.get('coverImage', ''), 60)
        && text(request.resource.data.get('coverAlt', ''), 200)
        && text(request.resource.data.get('thumb', ''), 90000)
        && text(request.resource.data.get('author', ''), 80);
      allow delete: if isAdmin();
    }

    // Pictures used inside posts (resized in the browser before saving). Public to read, admins only to change.
    match /postImages/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && id.matches('[a-z0-9]+(-[a-z0-9]+)*') && id.size() <= 60
        && request.resource.data.keys().hasOnly(['data', 'alt', 'createdAt'])
        && text(request.resource.data.data, 450000) && request.resource.data.data.startsWith('data:image/')
        && text(request.resource.data.get('alt', ''), 200);
      allow delete: if isAdmin();
    }
  }
}
